# =============================================================================
# Docker Compose — Finance App Deployment
# =============================================================================
# Generated by Ansible from template docker-compose.yml.j2
# Environment: {{ environment }}
# Generated at: {{ ansible_date_time.iso8601 | default('N/A') }}
# =============================================================================

services:
  finance-app:
    image: {{ app_image }}
    container_name: {{ app_name }}-{{ environment }}
    restart: unless-stopped
    ports:
      - "{{ app_port }}:{{ app_internal_port }}"
    environment:
      - APP_ENV={{ environment }}
      - APP_VERSION={{ app_version | default('latest') }}
      - APP_NAME={{ app_name }}
      - LOG_LEVEL={{ log_level | default('INFO') }}
      - DEBUG={{ debug_mode | default('false') }}
    labels:
      - "project={{ app_name }}"
      - "environment={{ environment }}"
      - "managed-by=ansible"
      - "version={{ app_version | default('latest') }}"
    healthcheck:
      test: ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://localhost:{{ app_internal_port }}/health')\" || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    networks:
      - finance-network
{% if environment == 'prod' %}
    deploy:
      resources:
        limits:
          memory: 512M
        reservations:
          memory: 256M
{% endif %}

networks:
  finance-network:
    driver: bridge
    name: {{ app_name }}-{{ environment }}-network
