# Template: alertmanager.yml.j2
# Generated: {{ ansible_date_time.iso8601 | default('N/A') }}
# =============================================================================

global:
  resolve_timeout: 5m
{% if smtp_smarthost is defined %}
  smtp_smarthost: '{{ smtp_smarthost }}'
  smtp_from: '{{ smtp_from }}'
  smtp_auth_username: '{{ smtp_auth_username }}'
  smtp_auth_password: '{{ smtp_auth_password }}'
  smtp_require_tls: true
{% endif %}

# Routing tree
route:
  group_by: ['alertname', 'severity', 'service']
  group_wait: 10s
  group_interval: 10s
  repeat_interval: 1h
  receiver: 'webhook-notifications'

  routes:
    - match:
        severity: critical
      receiver: 'webhook-notifications'
      group_wait: 5s
      repeat_interval: 30m
      continue: false

    - match:
        severity: warning
      receiver: 'webhook-notifications'
      group_wait: 30s
      repeat_interval: 2h
      continue: false

# Inhibition rules
inhibit_rules:
  - source_match:
      severity: 'critical'
    target_match:
      severity: 'warning'
    equal: ['service']

# Receivers
receivers:
  - name: 'webhook-notifications'
    webhook_configs:
      - url: '{{ alert_webhook_url }}'
        send_resolved: true
        http_config:
          follow_redirects: true

{% if email_receiver is defined and email_receiver %}
  - name: 'email-notifications'
    email_configs:
      - to: '{{ alert_email_to }}'
        send_resolved: true
        headers:
          Subject: {% raw %}'[{{ .Status | toUpper }}] {{ .GroupLabels.alertname }}'{% endraw %}
{% endif %}
