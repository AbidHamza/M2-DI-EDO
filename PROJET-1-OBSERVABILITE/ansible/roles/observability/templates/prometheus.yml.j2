# =============================================================================
# This file is a Jinja2 template rendered by Ansible.
# Variables are injected from the playbook or role defaults.
#
# Template: prometheus.yml.j2
# Generated: {{ ansible_date_time.iso8601 | default('N/A') }}
# =============================================================================

global:
  scrape_interval: {{ scrape_interval }}
  evaluation_interval: {{ scrape_interval }}
  external_labels:
    cluster: "observability-demo"
    environment: "{{ ansible_env.ENV | default('development') }}"
    managed_by: "ansible"

# Alert rules file
rule_files:
  - "alert-rules.yml"

# Alertmanager connection
alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - "alertmanager:{{ alertmanager_port }}"

# Scrape targets
scrape_configs:
  # Flask Application
  - job_name: "{{ app_name }}"
    scrape_interval: {{ scrape_interval }}
    metrics_path: "/metrics"
    static_configs:
      - targets: ["app:{{ app_port }}"]
        labels:
          service: "{{ app_name }}"
          team: "backend"

  # Node Exporter (system metrics)
  - job_name: "node-exporter"
    scrape_interval: {{ scrape_interval }}
    static_configs:
      - targets: ["node-exporter:{{ node_exporter_port }}"]
        labels:
          service: "node-exporter"
          team: "infrastructure"

  # Prometheus self-monitoring
  - job_name: "prometheus"
    scrape_interval: {{ scrape_interval }}
    static_configs:
      - targets: ["localhost:{{ prometheus_port }}"]
        labels:
          service: "prometheus"
          team: "observability"
